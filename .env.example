# ============================================
# Environment Variables Template
# ============================================
# Copy to .env.local for local development: cp .env.example .env.local
# See .env.development, .env.staging, .env.production for environment-specific defaults
#
# Priority (highest to lowest):
#   1. .env.local              (always loaded, gitignored)
#   2. .env.[environment]      (development | staging | production)
#   3. .env                    (fallback)

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_ENV="development"

# Database
MONGODB_URI="mongodb://localhost:27017/bonby"

# Auth (generate with: openssl rand -base64 32)
AUTH_SECRET="your-auth-secret-here"
